<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F4FAFA"
    android:padding="16dp">

    <!-- Main Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="#FFFFFF"
        app:cardCornerRadius="28dp"
        app:cardElevation="5dp"
        app:strokeColor="#DDEEEE"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Header -->
            <TextView
                android:id="@+id/tvRiwayatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Riwayat Peminjaman"
                android:textColor="#222222"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRiwayatSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Lihat aktivitas peminjaman"
                android:textColor="#666666"
                android:textSize="14sp" />

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:background="#EEEEEE" />

            <!-- Tabs -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8FDFD"
                app:tabIndicatorColor="#41E0D0"
                app:tabIndicatorFullWidth="false"
                app:tabRippleColor="#D8F5F2"
                app:tabSelectedTextColor="#41E0D0"
                app:tabTextColor="#666666" />

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRiwayat"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="20dp"
                android:clipToPadding="false"
                android:paddingBottom="12dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
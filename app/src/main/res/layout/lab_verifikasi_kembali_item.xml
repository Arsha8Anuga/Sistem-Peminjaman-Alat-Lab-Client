<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nama Alat -->
        <TextView
            android:id="@+id/tv_nama_alat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oscilloscope"
            android:textColor="#000000"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="8dp" />

        <!-- Jumlah -->
        <TextView
            android:id="@+id/tv_jumlah"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jumlah: 2"
            android:textColor="#444444"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <!-- Kondisi Awal -->
        <TextView
            android:id="@+id/tv_kondisi_awal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kondisi Awal: Baik"
            android:textColor="#444444"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <!-- Kondisi Akhir -->
        <TextView
            android:id="@+id/tv_kondisi_akhir"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kondisi Akhir: Rusak Ringan"
            android:textColor="#D32F2F"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="6dp" />

        <!-- Catatan Mahasiswa -->
        <TextView
            android:id="@+id/tv_catatan_mahasiswa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Catatan: Tombol power longgar"
            android:textColor="#666666"
            android:textSize="13sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/gradient_card"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Pengajuan Peminjaman"
            android:textColor="#222222"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_marginTop="4dp"
            android:gravity="center|top"
            android:text="Lengkapi formulir peminjaman berikut"
            android:textColor="#666666"
            android:textSize="14sp" />

        <!-- Divider -->

        <!-- Main Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#FFFFFF"
            app:cardCornerRadius="28dp"
            app:cardElevation="5dp"
            app:strokeColor="#DDEEEE"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Equipment -->
                <TextView
                    android:id="@+id/tvCartTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alat yang Dipinjam"
                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCart"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:layout_marginTop="14dp"
                    android:clipToPadding="false" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#EEEEEE" />

                <!-- Borrower Information -->
                <TextView
                    android:id="@+id/tvUserInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Informasi Peminjam"
                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etNama"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#41E0D0"
                    android:enabled="false"
                    android:hint="Nama Mahasiswa"
                    android:padding="14dp"
                    android:textColor="#222222"
                    android:textColorHint="#9AA5A5" />

                <EditText
                    android:id="@+id/etNim"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#41E0D0"
                    android:enabled="false"
                    android:hint="NIM"
                    android:padding="14dp"
                    android:textColor="#222222"
                    android:textColorHint="#9AA5A5" />

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#EEEEEE" />

                <!-- Borrow Schedule -->
                <TextView
                    android:id="@+id/tvBorrowDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jadwal Peminjaman"
                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Tanggal Pinjam -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                    app:endIconTint="#41E0D0">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTanggalPinjam"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="Tanggal Pinjam"
                        android:padding="14dp"
                        android:textColor="#222222"
                        android:textColorHint="#9AA5A5" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Tanggal Kembali -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:endIconMode="custom"
                    app:endIconDrawable="@android:drawable/ic_menu_my_calendar"
                    app:endIconTint="#41E0D0">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTanggalKembali"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:clickable="true"
                        android:focusable="false"
                        android:hint="Tanggal Kembali"
                        android:padding="14dp"
                        android:textColor="#222222"
                        android:textColorHint="#9AA5A5" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#EEEEEE" />

                <!-- Notes -->
                <TextView
                    android:id="@+id/tvNotes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Catatan Tambahan"
                    android:textColor="#222222"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etCatatan"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#41E0D0"
                    android:gravity="top"
                    android:hint="Masukkan tujuan peminjaman atau catatan..."
                    android:padding="14dp"
                    android:textColor="#222222"
                    android:textColorHint="#9AA5A5" />

                <!-- Submit Button -->
                <Button
                    android:id="@+id/btnAjukan"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="32dp"
                    android:backgroundTint="#41E0D0"
                    android:text="Ajukan Peminjaman"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Nama -->
        <TextView
            android:id="@+id/namaPeminjamTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fathan Eka"
            android:textColor="#000000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="5dp" />

        <!-- Nama Alat -->
        <TextView
            android:id="@+id/namaAlatTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Peminjaman: Oscilloscope"
            android:textColor="#444444"
            android:textSize="16sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="4dp" />

        <!-- Tanggal -->
        <TextView
            android:id="@+id/tanggalTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 Mei 2026"
            android:textColor="#666666"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/statusTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Pending"
            android:textColor="#FF9800"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="15dp" />

        <!-- Input alasan -->
        <EditText
            android:id="@+id/alasanTolakEdt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#41E2D2"
            android:hint="Masukkan alasan jika ditolak"
            android:inputType="textMultiLine"
            android:minHeight="80dp"
            android:padding="10dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- Tombol -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/setujuiBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:backgroundTint="#41E2D2"
                android:text="Setujui"
                android:textColor="#000000"
                android:textStyle="bold" />

            <Button
                android:id="@+id/tolakBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#D32F2F"
                android:text="Tolak"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_card"
        android:gravity="center|center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Tambah / Edit Alat"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="350dp"
            android:layout_height="wrap_content"
            app:cardCornerRadius="25dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Judul -->

                <!-- Nama Alat -->
                <EditText
                    android:id="@+id/namaAlat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#41E2D2"
                    android:hint="Nama Alat"
                    android:inputType="textPersonName"
                    android:padding="12dp" />

                <!-- Kode Alat -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <EditText
                    android:id="@+id/kodeAlat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#41E2D2"
                    android:hint="Kode Alat"
                    android:inputType="text"
                    android:padding="12dp" />

                <!-- Stok -->
                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <!-- Kondisi -->

                <EditText
                    android:id="@+id/stokAlat"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#41E2D2"
                    android:hint="Jumlah Stok"
                    android:inputType="number"
                    android:padding="12dp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <TextView
                    android:id="@+id/textKondisi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Kondisi Alat"
                    android:textSize="20sp" />

                <RadioGroup
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="left"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radiobuttonbaik"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="baik" />

                    <RadioButton
                        android:id="@+id/radiobuttonrusakringan"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="rusak ringan" />

                    <RadioButton
                        android:id="@+id/radiobuttonrusakberat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="rusak berat" />
                </RadioGroup>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <Spinner
                    android:id="@+id/spinnerKategori"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="15dp" />

                <!-- Upload Foto -->
                <ImageView
                    android:id="@+id/imagePreview"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:layout_gravity="center"
                    android:background="#D9D9D9"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <Button
                    android:id="@+id/uploadFotoBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#41E2D2"
                    android:text="Upload Foto"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="15dp" />

                <!-- Deskripsi -->
                <EditText
                    android:id="@+id/deskripsiAlat"
                    android:layout_width="match_parent"
                    android:layout_height="120dp"
                    android:backgroundTint="#41E2D2"
                    android:gravity="top"
                    android:hint="Deskripsi Alat"
                    android:inputType="textMultiLine"
                    android:padding="12dp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="20dp" />

                <!-- Tombol -->
                <Button
                    android:id="@+id/simpanBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#41E2D2"
                    android:text="Simpan"
                    android:textColor="#000000"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="10dp" />

                <Button
                    android:id="@+id/batalBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#0D1528"
                    android:text="Batal"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
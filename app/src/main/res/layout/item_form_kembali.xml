<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Nama Alat -->
        <TextView
            android:id="@+id/txtNamaAlat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Oscilloscope"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="#000000"/>

        <!-- Kondisi Awal -->
        <TextView
            android:id="@+id/txtKondisiAwal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kondisi Awal: Baik"
            android:textSize="14sp"
            android:textColor="#666666"
            android:layout_marginTop="4dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>

        <!-- Pilihan Kondisi -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kondisi Saat Dikembalikan"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="14sp"/>

        <Spinner
            android:id="@+id/spinnerKondisi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"/>

        <!-- Catatan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Catatan"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="14sp"
            android:layout_marginTop="12dp"/>

        <EditText
            android:id="@+id/etCatatan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tambahkan catatan jika ada kerusakan"
            android:minHeight="100dp"
            android:gravity="top"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:inputType="textMultiLine"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
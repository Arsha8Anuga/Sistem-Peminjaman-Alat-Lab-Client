<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- TITLE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verifikasi Pengembalian"
            android:textColor="#000000"
            android:textSize="24sp"
            android:textStyle="bold" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- CARD INFO -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tv_kode_peminjaman"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kode: PMJ-001"
                    android:textColor="#000000"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_nama_mahasiswa"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Mahasiswa: Jaq"
                    android:textColor="#444444" />

                <TextView
                    android:id="@+id/tv_tanggal_kembali"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tanggal kembali: 15 Mei 2026"
                    android:textColor="#444444" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- LIST DETAIL -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_detail_kembali"
            android:layout_width="match_parent"
            android:layout_height="300dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <!-- STATUS -->
        <Spinner
            android:id="@+id/spinner_status_verifikasi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- DENDA -->
        <EditText
            android:id="@+id/et_denda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Input denda"
            android:inputType="numberDecimal" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp" />

        <!-- CATATAN -->
        <EditText
            android:id="@+id/et_catatan_verifikasi"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:hint="Catatan verifikasi"
            android:inputType="textMultiLine" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <!-- BUTTON -->
        <Button
            android:id="@+id/btn_verifikasi_kembali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#7FFFD4"
            android:text="Verifikasi Pengembalian"
            android:textColor="#000000"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>